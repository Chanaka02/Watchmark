# Copy to deploy/production.env on the server and fill in real values.
# deploy/production.env is git-ignored: never commit it. Keep it readable by
# the deploying user only (chmod 600).

# --- Site ---
# The public domain; Caddy obtains its HTTPS certificate automatically.
SITE_ADDRESS=watchmark.example.org

# --- Database (only reachable inside the Docker network) ---
DB_NAME=watchmark
DB_USERNAME=watchmark
# Long random values, e.g.: openssl rand -base64 32
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# --- Show metadata ---
# API Read Access Token from https://www.themoviedb.org/settings/api
TMDB_READ_ACCESS_TOKEN=
METADATA_PROVIDER=tmdb

# --- Images to run (set by the deploy steps; a tag per release enables rollback) ---
BACKEND_IMAGE=watchmark-backend:latest
WEB_IMAGE=watchmark-web:latest
