# Copy to .env and fill in real values. .env is git-ignored: never commit it.
# Read by docker compose (repo root) and by the backend (spring.config.import).

# --- Database (local Docker MySQL) ---
DB_HOST=localhost
DB_PORT=3307
DB_NAME=watchmark
DB_USERNAME=watchmark
DB_PASSWORD=change-me-local-only
DB_ROOT_PASSWORD=change-me-root-local-only

# --- Sessions ---
# Must be true in production (HTTPS). Keep false for http://localhost.
SESSION_COOKIE_SECURE=false
# Server-side idle timeout, e.g. 14d, 12h.
SESSION_TIMEOUT=14d

# --- TMDB (used from Milestone 2) ---
# API Read Access Token from https://www.themoviedb.org/settings/api
# Leave empty to run with the mock metadata provider.
TMDB_READ_ACCESS_TOKEN=
